# Copy this file to <release-package>/repo-map.env and edit the values.
HF_NAMESPACE=
HF_PRIVATE=0
HF_MODELS_REPO=cv801_models

# Create an empty repository first. HTTPS and SSH URLs are both supported.
GITHUB_REPO_URL=

# The default scripts are dry-run. Set these only for an intentional upload.
EXECUTE=0
ALLOW_LOCATEANYTHING_WEIGHTS=NO
