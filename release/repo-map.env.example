# Copy this file to <release-package>/repo-map.env and edit the values.
HF_NAMESPACE=
HF_PRIVATE=1
HF_DATA_REPO=cv801-data
HF_RESULTS_REPO=cv801-experiment-results
HF_YOLO26X_REPO=cv801-yolo26x
HF_GROUNDING_DINO_REPO=cv801-grounding-dino-tiny
HF_LOCATEANYTHING_REPO=cv801-locateanything-3b
HF_QWEN_T1_REPO=cv801-qwen3.5-9b-t1-lora
HF_QWEN_T2_REPO=cv801-qwen3.5-9b-t2-lora

# Create an empty repository first. HTTPS and SSH URLs are both supported.
GITHUB_REPO_URL=

# The default scripts are dry-run. Set these only for an intentional upload.
EXECUTE=0
ALLOW_LOCATEANYTHING_WEIGHTS=NO
